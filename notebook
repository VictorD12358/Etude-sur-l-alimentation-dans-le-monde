    "# Calculer la part cumulative\n",
    "dispo_animale_tri['pourcentage cumulé'] = dispo_animale_tri['Disponibilité alimentaire (Kcal/personne/jour) origine animale par pays'].cumsum() /total_kcal_animale\n",
